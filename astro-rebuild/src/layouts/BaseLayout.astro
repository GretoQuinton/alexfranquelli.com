---
import '../styles/global.css';
const {
  title='Alex Franquelli — Writer',
  description='Writing on music, politics and culture by Alex Franquelli.',
  lang='en',
  type='website',
  image=null,
  jsonLd=null
}=Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const socialImage = image ? new URL(image, Astro.site).toString() : null;
const path = Astro.url.pathname;
const nav = [
  { href:'/writing', label:'Writing' },
  { href:'/fiction', label:'Fiction' },
  { href:'/about', label:'About' },
  { href:'/contact', label:'Contact' }
];
const isActive=(href:string)=>href==='/' ? path==='/' : path===href || path.startsWith(href+'/');
const personJsonLd = JSON.stringify({
  '@context':'https://schema.org',
  '@type':'Person',
  name:'Alex Franquelli',
  url:'https://www.alexfranquelli.com',
  sameAs:['https://uk.linkedin.com/in/alexfranquelli','https://www.goodreads.com/author/show/8057489.Alex_Franquelli'],
  knowsLanguage:['English','Italian']
});
---
<!doctype html>
<html lang={lang}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content={description} />
  <meta name="google-site-verification" content="7EnSmlG7yZ5YM5op5gQunfoZfKswzvU_ajwcW-d0iI0" />
  <meta name="theme-color" content="#f1eee6" />
  <!-- PRE-LAUNCH: switch to index,follow when alexfranquelli.com points here. -->
  <meta name="robots" content="noindex,nofollow" />
  <link rel="canonical" href={canonical} />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <meta property="og:type" content={type} />
  <meta property="og:site_name" content="Alex Franquelli" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  {socialImage&&<meta property="og:image" content={socialImage} />}
  <meta name="twitter:card" content={socialImage?'summary_large_image':'summary'} />
  {socialImage&&<meta name="twitter:image" content={socialImage} />}
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <script type="application/ld+json" set:html={personJsonLd}></script>
  {jsonLd&&<script type="application/ld+json" set:html={jsonLd}></script>}
  <title>{title}</title>
</head>
<body>
<a class="skip-link" href="#content">Skip to content</a>
<header class="site-header">
  <div class="wrap masthead">
    <a class="brand" href="/" aria-label="Alex Franquelli — home">
      <span class="brand-name">Alex Franquelli</span>
      <span class="brand-role">Writer</span>
    </a>
    <nav class="nav" aria-label="Primary">
      {nav.map(item => <a href={item.href} aria-current={isActive(item.href)?'page':undefined}>{item.label}</a>)}
    </nav>
  </div>
</header>
<main id="content"><slot /></main>
<footer class="site-footer">
  <div class="wrap footer-grid">
    <div>
      <div class="footer-name">Alex Franquelli</div>
      <p>Criticism, essays and fiction.<br />London.</p>
    </div>
    <div class="footer-links">
      <a href="/writing">Writing</a>
      <a href="/about">About</a>
      <a href="/fiction">Fiction</a>
    </div>
    <div class="footer-links footer-contact">
      <a href="/contact">Contact</a>
      <a href="https://uk.linkedin.com/in/alexfranquelli" target="_blank" rel="me noopener">LinkedIn ↗</a>
      <a href="https://www.goodreads.com/author/show/8057489.Alex_Franquelli" target="_blank" rel="me noopener">Goodreads ↗</a>
    </div>
  </div>
  <div class="wrap footer-bottom">
    <span>© {new Date().getFullYear()} Alex Franquelli</span>
    <span class="footer-visitor-counter" data-visitor-counter hidden title="Approximate visits: counted once per browser every 24 hours">
      Visits <output data-visitor-total></output>
    </span>
  </div>
</footer>
<script is:inline>
  // Apply the same behaviour to external links inside rendered article bodies.
  (() => {
    const internalHosts = new Set([window.location.hostname, 'alexfranquelli.com', 'www.alexfranquelli.com']);
    document.querySelectorAll('a[href]').forEach(link => {
      try {
        const url = new URL(link.getAttribute('href'), window.location.href);
        if (!['http:', 'https:'].includes(url.protocol) || internalHosts.has(url.hostname)) return;
        link.target = '_blank';
        link.relList.add('noopener');
      } catch {
        // Leave malformed URLs unchanged.
      }
    });
  })();
</script>
<script is:inline>
  // A privacy-conscious site visit counter. Only a timestamp is stored in the
  // visitor's browser; no identity, IP address or identifier is sent to storage.
  (async () => {
    const container = document.querySelector('[data-visitor-counter]');
    const total = document.querySelector('[data-visitor-total]');
    if (!container || !total) return;

    const key = 'alexfranquelli-counted-until-v1';
    const now = Date.now();
    let countedRecently = false;
    try {
      countedRecently = Number(localStorage.getItem(key) || 0) > now;
    } catch {
      // Storage may be disabled by browser privacy settings.
    }

    const respectsDNT = navigator.doNotTrack === '1' ||
      navigator.globalPrivacyControl === true;
    const shouldCount = !countedRecently && !respectsDNT;

    try {
      const response = await fetch('/api/visits', {
        method: shouldCount ? 'POST' : 'GET',
        cache: 'no-store',
        credentials: 'same-origin',
        headers: { Accept: 'application/json' },
      });
      if (!response.ok) return;
      const data = await response.json();
      if (!Number.isSafeInteger(data.visits) || data.visits < 0) return;

      total.textContent = new Intl.NumberFormat('en-GB').format(data.visits);
      container.hidden = false;

      if (shouldCount) {
        try {
          localStorage.setItem(key, String(now + 24 * 60 * 60 * 1000));
        } catch {
          // Counting still works when persistent browser storage is disabled.
        }
      }
    } catch {
      // If Cloudflare is unavailable, hide the counter instead of showing a
      // misleading zero. This also keeps old static previews tidy.
    }
  })();
</script>
</body>
</html>
