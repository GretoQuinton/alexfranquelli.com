---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
const sortDate=(value?:string)=>value ? (Date.parse(value.length===4?`${value}-01-01`:value.length===7?`${value}-01`:value)||0) : 0;
const writing=(await getCollection('writing',({data})=>!data.draft)).sort((a,b)=>sortDate(b.data.publicationDate)-sortDate(a.data.publicationDate));
---
<BaseLayout>
<section class="wrap hero">
  <div class="eyebrow">Writer · Film &amp; TV · Rome / London</div>
  <h1>Alex Franquelli</h1>
  <p class="intro">Writing across music, politics and culture, with a parallel career in film and television.</p>
</section>
<section class="wrap section">
  <h2>Selected writing</h2>
  {writing.slice(0,6).map(a => <article class="article-row"><a href={'/writing/'+a.data.slug}>{a.data.title}</a><span>{a.data.publication}</span><span>{a.data.displayDate||a.data.publicationDate||'Date to verify'}</span></article>)}
</section>
</BaseLayout>
