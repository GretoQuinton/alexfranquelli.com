---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { getRecoveredImage } from '../lib/recoveredImages';
const sortDate=(value?:string)=>value ? (Date.parse(value.length===4?`${value}-01-01`:value.length===7?`${value}-01`:value)||0) : 0;
const writing=(await getCollection('writing',({data})=>!data.draft)).sort((a,b)=>sortDate(b.data.publicationDate)-sortDate(a.data.publicationDate));
const carouselSlugs=[
  'shellac-live-at-netil-house-london',
  'ameen-saleem-the-groove-lab',
  'drott-orcus',
  'fennesz-becs',
  'nine-inch-nails-hesitation-marks',
  'horseback-piedmont-apocrypha'
];
const textFeatureSlugs=[
  'the-mountaineers-the-killers-the-vanity-set-barfky-london-uk',
  'genitorturers-shock-n-roll-revolution-ritual',
  'the-tipping-point-of-mongolia'
];
const resolveImage=(article:any)=>{
  const recovered=getRecoveredImage(article.data.slug,article.data.title);
  const explicit=article.data.image?{src:article.data.image,alt:article.data.imageAlt||''}:null;
  return article.data.image&&!article.data.image.includes('squarespace-cdn.com')?explicit:(recovered||explicit);
};
const carouselCards=carouselSlugs
  .map(slug=>writing.find(a=>a.data.slug===slug))
  .filter(Boolean)
  .map(article=>({article,image:resolveImage(article)}))
  .filter(({image})=>Boolean(image));
const archive=textFeatureSlugs.map(slug=>writing.find(a=>a.data.slug===slug)).filter(Boolean);
const dated=writing.map(a=>a.data.publicationDate).filter(Boolean) as string[];
const years=dated.map(d=>Number(d.slice(0,4))).filter(Boolean);
const span=years.length?`${Math.min(...years)}—${Math.max(...years)}`:'Two decades';
const publications=new Set(writing.map(a=>a.data.publication?.trim().toLowerCase().replace(/[^a-z0-9]+/g,'')).filter(Boolean));
const heroImage=getRecoveredImage('__homeHero','')?.src||'https://images.squarespace-cdn.com/content/v1/658e990e3cae2759c6d9f2ff/7d580778-c1f9-45d0-b073-ce2166a984b4/IMG_2633.jpeg';
---
<BaseLayout description="Alex Franquelli is a writer based between London and Rome. Browse reviews, interviews and features on music, politics and culture." image={heroImage}>
<section class="hero wrap">
  <div class="hero-grid">
    <div>
      <div class="eyebrow">Writer · London / Rome</div>
      <h1>Alex<br />Franquelli</h1>
    </div>
    <div class="hero-copy">
      <p class="intro">Writing on music, politics and culture, published in English and Italian.</p>
      <p class="hero-note">An independent archive of reviews, interviews, live reports and longer features.</p>
      <div class="actions">
        <a class="button" href="/writing">Explore the archive</a>
        <a class="text-link" href="/about">About Alex ↗</a>
      </div>
    </div>
  </div>
  <figure class="hero-media">
    <img src={heroImage} alt="" aria-hidden="true" loading="eager" fetchpriority="high" />
  </figure>
  <div class="stats" aria-label="Archive at a glance">
    <div><strong>{writing.length}</strong><span>pieces online</span></div>
    <div><strong>{span}</strong><span>published work</span></div>
    <div><strong>{publications.size}</strong><span>publications represented</span></div>
    <div><strong>EN / IT</strong><span>two languages</span></div>
  </div>
</section>

<section class="wrap section featured-section">
  <div class="section-heading">
    <div><div class="eyebrow">Portfolio</div><h2>Selected writing</h2></div>
    <div class="featured-heading-actions">
      <div class="carousel-controls" aria-label="Selected writing carousel controls">
        <button class="carousel-button" type="button" data-carousel-prev aria-label="Previous selected article">←</button>
        <span class="carousel-count"><span data-carousel-current>1</span> / <span data-carousel-total>{Math.ceil(carouselCards.length/3)}</span></span>
        <button class="carousel-button" type="button" data-carousel-next aria-label="Next selected article">→</button>
      </div>
      <a class="text-link" href="/writing">View all {writing.length} pieces ↗</a>
    </div>
  </div>

  <div class="featured-carousel" data-carousel>
    <div class="featured-track" data-carousel-track tabindex="0" aria-label="Selected writing">
      {carouselCards.map(({article:a,image},i) => <article class="feature-card" data-carousel-card>
        <a class="feature-card-link" href={'/writing/'+a.data.slug}>
          <img class="feature-image" src={image.src} alt={image.alt} loading={i<2?'eager':'lazy'} />
          <div class="feature-index">{String(i+1).padStart(2,'0')}</div>
          <div class="feature-meta">
            <span>{a.data.publication||'Archive'}</span>
            <span>{a.data.displayDate||a.data.publicationDate||''}</span>
          </div>
          <h3>{a.data.title}</h3>
          <p>{a.data.type}</p>
          <span class="feature-arrow" aria-hidden="true">↗</span>
        </a>
      </article>)}
    </div>
  </div>

  {archive.length>0&&<div class="archive-preview">
    <div class="eyebrow">Also selected</div>
    {archive.map(a => <article class="article-row">
      <a href={'/writing/'+a.data.slug}>{a.data.title}</a>
      <span>{a.data.publication||'Publication unconfirmed'}</span>
      <span>{a.data.displayDate||a.data.publicationDate||'Date unconfirmed'}</span>
    </article>)}
  </div>}

  <script is:inline>
    const carousel=document.querySelector('[data-carousel]');
    const track=carousel?.querySelector('[data-carousel-track]');
    const cards=track?[...track.querySelectorAll('[data-carousel-card]')]:[];
    const prev=document.querySelector('[data-carousel-prev]');
    const next=document.querySelector('[data-carousel-next]');
    const current=document.querySelector('[data-carousel-current]');
    const total=document.querySelector('[data-carousel-total]');

    function perPage(){
      return window.matchMedia('(min-width: 901px)').matches?3:1;
    }

    function pageCount(){
      return Math.max(1,Math.ceil(cards.length/perPage()));
    }

    function pageOffsets(){
      const step=perPage();
      return Array.from({length:pageCount()},(_,page)=>{
        const card=cards[Math.min(cards.length-1,page*step)];
        if(!track||!card) return 0;
        return Math.min(card.offsetLeft,Math.max(0,track.scrollWidth-track.clientWidth));
      });
    }

    function currentPage(){
      if(!track) return 0;
      const offsets=pageOffsets();
      let best=0;
      let distance=Infinity;
      offsets.forEach((offset,index)=>{
        const delta=Math.abs(track.scrollLeft-offset);
        if(delta<distance){distance=delta;best=index;}
      });
      return best;
    }

    function updateCarousel(){
      const page=currentPage();
      const pages=pageCount();
      if(current) current.textContent=String(page+1);
      if(total) total.textContent=String(pages);
      if(prev) prev.disabled=page===0;
      if(next) next.disabled=page===pages-1;
    }

    function go(direction){
      if(!track||!cards.length) return;
      const target=Math.max(0,Math.min(pageCount()-1,currentPage()+direction));
      const offsets=pageOffsets();
      track.scrollTo({left:offsets[target],behavior:'smooth'});
    }

    let scrollTimer;
    prev?.addEventListener('click',()=>go(-1));
    next?.addEventListener('click',()=>go(1));
    track?.addEventListener('scroll',()=>{
      clearTimeout(scrollTimer);
      scrollTimer=setTimeout(updateCarousel,80);
    },{passive:true});
    track?.addEventListener('keydown',event=>{
      if(event.key==='ArrowLeft'){event.preventDefault();go(-1);}
      if(event.key==='ArrowRight'){event.preventDefault();go(1);}
    });
    window.addEventListener('resize',updateCarousel,{passive:true});
    updateCarousel();
  </script>
</section>

<section class="now-section">
  <div class="wrap now-grid">
    <div>
      <div class="eyebrow">Now · September 2026</div>
      <h2>Current things.</h2>
    </div>
    <div class="now-list">
      <div><span>Finishing</span><p>An untitled novel — end of third draft.</p></div>
      <div><span>Writing / thinking about</span><p>What would I do if I were stuck in a cube with no exits or windows for 70 years?</p></div>
      <div><span>Reading</span><p><em>A Little Life</em> by Hanya Yanagihara</p></div>
      <div><span>Listening to</span><p><em>Vault</em> by Miles</p></div>
    </div>
    <a class="text-link" href="https://www.goodreads.com/author/show/8057489.Alex_Franquelli" rel="me noopener">Goodreads ↗</a>
  </div>
</section>

<section class="statement">
  <div class="wrap statement-grid">
    <div class="eyebrow">The archive</div>
    <p>This site preserves published work that has lived across magazines, newspapers and music publications — including pieces no longer easy to find at their original URLs.</p>
    <a class="button button-light" href="/writing">Browse writing</a>
  </div>
</section>
</BaseLayout>
