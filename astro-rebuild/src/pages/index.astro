---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { getRecoveredImage } from '../lib/recoveredImages';

const parseDate=(value?:string,display?:string)=>{
  if(value) return Date.parse(value.length===4?`${value}-01-01`:value.length===7?`${value}-01`:value)||0;
  const year=display?.match(/\b(19|20)\d{2}\b/)?.[0];
  return year?Date.parse(`${year}-01-01`):0;
};
const writing=(await getCollection('writing',({data})=>!data.draft))
  .sort((a,b)=>parseDate(b.data.publicationDate,b.data.displayDate)-parseDate(a.data.publicationDate,a.data.displayDate));

const decodeEntities=(value:string)=>value
  .replace(/&nbsp;/gi,' ')
  .replace(/&amp;/gi,'&')
  .replace(/&quot;/gi,'"')
  .replace(/&#39;|&apos;/gi,"'")
  .replace(/&ldquo;|&rdquo;/gi,'"')
  .replace(/&lsquo;|&rsquo;/gi,"'");
const excerpt=(article:any,max=430)=>{
  const match=(article.body||'').match(/<p[^>]*>([\s\S]*?)<\/p>/i);
  const clean=decodeEntities((match?.[1]||article.body||'').replace(/<[^>]+>/g,' ').replace(/\s+/g,' ').trim());
  if(clean.length<=max) return clean;
  const clipped=clean.slice(0,max+1).replace(/\s+\S*$/,'');
  return clipped+'…';
};
const imageFor=(article:any)=>{
  const recovered=getRecoveredImage(article.data.slug,article.data.title);
  const explicit=article.data.image&&!article.data.image.includes('squarespace-cdn.com')
    ? {src:article.data.image,alt:article.data.imageAlt||''}
    : null;
  return explicit||recovered;
};
const langCode=(language:string)=>language==='Italian'?'IT':'EN';
const publicationKey=(value?:string)=>(value||'').trim().toLowerCase().replace(/[^a-z0-9]+/g,'');

const centerpiece=writing.find(a=>a.data.slug==='the-tipping-point-of-mongolia')||writing[0];
const fallbackSelected=[
  'shellac-live-at-netil-house-london',
  'nine-inch-nails-hesitation-marks',
  'ameen-saleem-the-groove-lab',
  'fennesz-becs',
  'drott-orcus',
  'ulver-messe-i-x-vi-x-indieforbunnies'
].map(slug=>writing.find(a=>a.data.slug===slug)).filter(Boolean);
const flagged=writing.filter(a=>a.data.featured&&a.data.slug!==centerpiece.data.slug);
const selected=[...flagged,...fallbackSelected.filter(a=>!flagged.some(f=>f.data.slug===a.data.slug))]
  .filter((a,i,all)=>all.findIndex(x=>x.data.slug===a.data.slug)===i)
  .slice(0,6)
  .map(article=>({article,image:imageFor(article),excerpt:excerpt(article,340)}));

const publicationCounts=new Map<string,{label:string,count:number,key:string}>();
for(const article of writing){
  const label=article.data.publication?.trim();
  if(!label) continue;
  const key=publicationKey(label);
  const current=publicationCounts.get(key);
  publicationCounts.set(key,{label:current?.label||label,count:(current?.count||0)+1,key});
}
const topPublications=[...publicationCounts.values()].sort((a,b)=>b.count-a.count||a.label.localeCompare(b.label)).slice(0,6);
const heroImage=getRecoveredImage('__homeHero','')?.src||'/images/recovered/home-hero.webp';
---

<BaseLayout
  description="Alex Franquelli is a writer and critic based between London and Rome, working across music, politics, culture and fiction."
  image={heroImage}
>
  <section class="hero wrap">
    <div class="hero-grid">
      <div>
        <div class="eyebrow">Critic · Essayist · Fiction writer</div>
        <h1>Alex<br />Franquelli</h1>
      </div>
      <div class="hero-copy">
        <p class="intro">Writing across music, politics and culture, between London and Rome.</p>
        <p class="hero-note">Italian and English criticism for <em>Ritual</em>, Musicboom, The Quietus, PopMatters, All About Jazz, The Line of Best Fit and others.</p>
        <div class="actions">
          <a class="button" href="#selected">Read selected work</a>
          <a class="text-link" href="/writing">All writing ↗</a>
        </div>
      </div>
    </div>

    <div class="hero-media" aria-hidden="true">
      <img src={heroImage} alt="" loading="eager" fetchpriority="high" />
    </div>

    <div class="identity-strip" aria-label="Writer profile">
      <span>London / Rome</span>
      <span>Music · Politics · Fiction</span>
      <span>IT / EN</span>
    </div>
  </section>

  <section id="selected" class="wrap editorial-feature">
    <div class="editorial-feature-label">
      <div class="eyebrow">Featured / 01</div>
      <span class="language-badge">[{langCode(centerpiece.data.language)}]</span>
    </div>
    <div class="editorial-feature-body">
      <div class="editorial-feature-meta">
        <span>{centerpiece.data.publication||'Published work'}</span>
        <span>{centerpiece.data.displayDate||centerpiece.data.publicationDate||''}</span>
        <span>{centerpiece.data.type}</span>
      </div>
      <h2>{centerpiece.data.title}</h2>
      <p class="editorial-opening" lang={centerpiece.data.language==='Italian'?'it':'en'}>{excerpt(centerpiece,620)}</p>
      <a class="button" href={'/writing/'+centerpiece.data.slug}>Read the piece</a>
    </div>
  </section>

  <section class="wrap section work-section">
    <div class="section-heading">
      <div>
        <div class="eyebrow">Portfolio</div>
        <h2>Selected criticism</h2>
      </div>
      <a class="text-link" href="/writing">All writing ↗</a>
    </div>

    <div class="work-showcase" data-work-showcase>
      <div class="work-index">
        {selected.map(({article:a,image,excerpt:pieceExcerpt},i)=>
          <a
            class="work-row"
            href={'/writing/'+a.data.slug}
            data-work-row
            data-title={a.data.title}
            data-excerpt={pieceExcerpt}
            data-publication={a.data.publication||'Published work'}
            data-language={langCode(a.data.language)}
            data-image={image?.src||''}
          >
            <span class="work-no">No. {String(i+1).padStart(3,'0')} //</span>
            <span class="work-title">{a.data.title}</span>
            <span class="work-publication">{a.data.publication||'Published work'}</span>
            <span class="language-badge">[{langCode(a.data.language)}]</span>
          </a>
        )}
      </div>

      <aside class="work-copy-pane" aria-live="polite">
        <div class="work-copy-meta">
          <span data-work-publication>{selected[0]?.article.data.publication||''}</span>
          <span data-work-language>[{selected[0]?langCode(selected[0].article.data.language):'EN'}]</span>
        </div>
        <p data-work-excerpt>{selected[0]?.excerpt||''}</p>
        <span class="work-copy-title" data-work-title>{selected[0]?.article.data.title||''}</span>
      </aside>

      <div class="work-float" data-work-float aria-hidden="true">
        <img data-work-image src={selected[0]?.image?.src||''} alt="" />
        <span>READ</span>
      </div>
    </div>

    <script is:inline>
      const showcase=document.querySelector('[data-work-showcase]');
      const rows=showcase?[...showcase.querySelectorAll('[data-work-row]')]:[];
      const paneTitle=showcase?.querySelector('[data-work-title]');
      const paneExcerpt=showcase?.querySelector('[data-work-excerpt]');
      const panePublication=showcase?.querySelector('[data-work-publication]');
      const paneLanguage=showcase?.querySelector('[data-work-language]');
      const float=showcase?.querySelector('[data-work-float]');
      const floatImage=showcase?.querySelector('[data-work-image]');

      function activate(row){
        if(!row) return;
        if(paneTitle) paneTitle.textContent=row.dataset.title||'';
        if(paneExcerpt) paneExcerpt.textContent=row.dataset.excerpt||'';
        if(panePublication) panePublication.textContent=row.dataset.publication||'';
        if(paneLanguage) paneLanguage.textContent='['+(row.dataset.language||'EN')+']';
        rows.forEach(item=>item.toggleAttribute('data-active',item===row));
        if(floatImage&&row.dataset.image) floatImage.src=row.dataset.image;
      }

      rows.forEach(row=>{
        row.addEventListener('mouseenter',()=>activate(row));
        row.addEventListener('focus',()=>activate(row));
        row.addEventListener('pointerenter',()=>{
          if(float&&row.dataset.image) float.classList.add('is-visible');
        });
        row.addEventListener('pointermove',event=>{
          if(!float||!row.dataset.image) return;
          float.style.left=(event.clientX+26)+'px';
          float.style.top=(event.clientY+22)+'px';
        });
        row.addEventListener('pointerleave',()=>float?.classList.remove('is-visible'));
      });
      activate(rows[0]);
    </script>
  </section>

  <section class="now-section">
    <div class="wrap">
      <div class="now-heading">
        <div class="eyebrow">Now · September 2026</div>
        <h2>Current things.</h2>
      </div>

      <div class="now-editorial-grid">
        <article class="draft-card">
          <span class="now-label">Manuscript</span>
          <strong>Untitled novel</strong>
          <em>Draft 3 / Revision phase</em>
        </article>

        <article class="thought-card">
          <span class="now-label">Writing / thinking about</span>
          <blockquote>What would I do if I were stuck in a cube with no exits or windows for 70 years?</blockquote>
        </article>

        <div class="now-notes">
          <div>
            <span class="now-label">Reading</span>
            <p><em>A Little Life</em><br />Hanya Yanagihara</p>
          </div>
          <div>
            <span class="now-label">Listening to</span>
            <p><em>Vault</em><br />Miles</p>
          </div>
          <a class="text-link" href="https://www.goodreads.com/author/show/8057489.Alex_Franquelli" rel="me noopener">Goodreads ↗</a>
        </div>
      </div>
    </div>
  </section>

  <section class="wrap publication-section">
    <div class="section-heading">
      <div>
        <div class="eyebrow">Body of work</div>
        <h2>Published with</h2>
      </div>
      <a class="text-link" href="/writing">Browse everything ↗</a>
    </div>
    <div class="publication-index">
      {topPublications.map((publication,i)=>
        <a href={'/writing?publication='+publication.key}>
          <span class="publication-no">{String(i+1).padStart(2,'0')}</span>
          <strong>{publication.label}</strong>
          <span class="publication-count">{publication.count} pieces</span>
        </a>
      )}
    </div>
  </section>
</BaseLayout>
