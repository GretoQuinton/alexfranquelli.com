---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
const sortDate=(value?:string)=>value ? (Date.parse(value.length===4?`${value}-01-01`:value.length===7?`${value}-01`:value)||0) : 0;
const writing=(await getCollection('writing',({data})=>!data.draft)).sort((a,b)=>sortDate(b.data.publicationDate)-sortDate(a.data.publicationDate));
const featured=writing.filter(a=>a.data.featured);
const selected=[...featured,...writing.filter(a=>!a.data.featured)].slice(0,6);
const lead=selected.slice(0,3);
const archive=selected.slice(3);
const dated=writing.map(a=>a.data.publicationDate).filter(Boolean) as string[];
const years=dated.map(d=>Number(d.slice(0,4))).filter(Boolean);
const span=years.length?`${Math.min(...years)}—${Math.max(...years)}`:'Two decades';
const publications=new Set(writing.map(a=>a.data.publication).filter(Boolean));
---
<BaseLayout description="Alex Franquelli is a writer based between Rome and London. Browse reviews, interviews and features on music, politics and culture.">
<section class="hero wrap">
  <div class="hero-grid">
    <div>
      <div class="eyebrow">Writer · Rome / London</div>
      <h1>Alex<br />Franquelli</h1>
    </div>
    <div class="hero-copy">
      <p class="intro">Writing on music, politics and culture, published in English and Italian.</p>
      <p class="hero-note">An independent archive of reviews, interviews, live reports and longer features.</p>
      <div class="actions">
        <a class="button" href="/writing">Explore the archive</a>
        <a class="text-link" href="/about">About Alex ↗</a>
      </div>
    </div>
  </div>
  <div class="stats" aria-label="Archive at a glance">
    <div><strong>{writing.length}</strong><span>pieces online</span></div>
    <div><strong>{span}</strong><span>published work</span></div>
    <div><strong>{publications.size}</strong><span>publications represented</span></div>
    <div><strong>EN / IT</strong><span>two languages</span></div>
  </div>
</section>

<section class="wrap section featured-section">
  <div class="section-heading">
    <div><div class="eyebrow">Portfolio</div><h2>Selected writing</h2></div>
    <a class="text-link" href="/writing">View all {writing.length} pieces ↗</a>
  </div>
  <div class="featured-grid">
    {lead.map((a,i) => <article class="feature-card">
      <a class="feature-card-link" href={'/writing/'+a.data.slug}>
        <div class="feature-index">0{i+1}</div>
        <div class="feature-meta"><span>{a.data.publication||'Archive'}</span><span>{a.data.displayDate||a.data.publicationDate||''}</span></div>
        <h3>{a.data.title}</h3>
        {a.data.description&&<p>{a.data.description}</p>}
        <span class="feature-arrow" aria-hidden="true">↗</span>
      </a>
    </article>)}
  </div>
  {archive.length>0&&<div class="archive-preview">
    <div class="eyebrow">More from the archive</div>
    {archive.map(a => <article class="article-row">
      <a href={'/writing/'+a.data.slug}>{a.data.title}</a>
      <span>{a.data.publication||'Publication to verify'}</span>
      <span>{a.data.displayDate||a.data.publicationDate||'Date to verify'}</span>
    </article>)}
  </div>}
</section>

<section class="statement">
  <div class="wrap statement-grid">
    <div class="eyebrow">The archive</div>
    <p>This site preserves published work that has lived across magazines, newspapers and music publications — including pieces no longer easy to find at their original URLs.</p>
    <a class="button button-light" href="/writing">Browse writing</a>
  </div>
</section>
</BaseLayout>
