---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';
import { getRecoveredImage } from '../../lib/recoveredImages';
import { auditedOriginalStatus } from '../../data/auditedLinkStates';
const sortDate=(value?:string)=>value ? (Date.parse(value.length===4?`${value}-01-01`:value.length===7?`${value}-01`:value)||0) : 0;
export async function getStaticPaths(){const writing=await getCollection('writing',({data})=>!data.draft);return writing.map(article=>({params:{slug:article.data.slug},props:{article}}))}
const { article }=Astro.props;
const { Content }=await render(article);
const d=article.data;
const recoveredImage=getRecoveredImage(d.slug,d.title);
const explicitImage=d.image?{src:d.image,alt:d.imageAlt||''}:null;
const resolvedImage=d.image&&!d.image.includes('squarespace-cdn.com')?explicitImage:(recoveredImage||explicitImage);
const originalStatus=d.originalUrlStatus||auditedOriginalStatus(d.slug);
const writing=(await getCollection('writing',({data})=>!data.draft)).sort((a,b)=>sortDate(b.data.publicationDate)-sortDate(a.data.publicationDate));
const currentIndex=writing.findIndex(a=>a.data.slug===d.slug);
const newer=currentIndex>0?writing[currentIndex-1]:null;
const older=currentIndex>=0&&currentIndex<writing.length-1?writing[currentIndex+1]:null;
const lang=d.language==='Italian'?'it':'en';
const canonical=new URL('/writing/'+d.slug, Astro.site).toString();
const imageUrl=resolvedImage?new URL(resolvedImage.src, Astro.site).toString():undefined;
const articleJsonLd=JSON.stringify({
  '@context':'https://schema.org',
  '@type':'Article',
  headline:d.title,
  description:d.description||undefined,
  url:canonical,
  mainEntityOfPage:canonical,
  author:{'@type':'Person',name:'Alex Franquelli',url:'https://www.alexfranquelli.com/about'},
  datePublished:d.publicationDate||undefined,
  inLanguage:lang,
  publisher:d.publication?{'@type':'Organization',name:d.publication}:undefined,
  image:imageUrl?[imageUrl]:undefined,
  isBasedOn:d.originalUrl||undefined
});
---
<BaseLayout title={d.title+' — Alex Franquelli'} description={d.description||`${d.title}, by Alex Franquelli.`} lang={lang} type="article" image={imageUrl} jsonLd={articleJsonLd}>
<article class="article" data-pagefind-body>
  <a class="back-link" href="/writing">← Writing archive</a>
  <header class="article-header">
    <div class="eyebrow">{d.type}{d.publication&&<> · {d.publication}</>}</div>
    <h1>{d.title}</h1>
    {d.description&&<p class="article-deck">{d.description}</p>}
    <div class="article-meta">
      <div><span>Publication</span><strong>{d.publication||'Unconfirmed'}</strong></div>
      <div><span>Date</span><strong>{d.displayDate||d.publicationDate||'Unconfirmed'}</strong></div>
      <div><span>Language</span><strong>{d.language}</strong></div>
      {d.byline&&<div><span>Byline</span><strong>{d.byline}</strong></div>}
    </div>
    {originalStatus==='live'&&d.originalUrl&&<a class="original-link" href={d.originalUrl} rel="noopener">View original publication ↗</a>}
    {originalStatus==='dead'&&d.archiveUrl&&<a class="original-link" href={d.archiveUrl} rel="noopener">View archived publication ↗</a>}
    {originalStatus==='dead'&&!d.archiveUrl&&<p class="original-note">The original publication is no longer online.</p>}
    {!originalStatus&&d.originalUrl&&<a class="original-link" href={d.originalUrl} rel="noopener">View original publication ↗</a>}
    {(!d.publicationDate||!d.publication)&&<p class="verification-note">Some archive metadata is still being verified. <a href="/contact">Corrections are welcome.</a></p>}
  </header>
  {resolvedImage&&<figure class="article-image">
    <img src={resolvedImage.src} alt={resolvedImage.alt} loading="eager" fetchpriority="high" />
    {(d.imageCredit||d.imageSourceUrl)&&<figcaption>
      {d.imageCredit&&<span>{d.imageCredit}</span>}
      {d.imageSourceUrl&&<a href={d.imageSourceUrl}>Image source ↗</a>}
    </figcaption>}
  </figure>}
  <div class="prose"><Content /></div>
  {(d.magazineIssue||d.printedPages||d.cover)&&<aside class="publication-card">
    <div class="eyebrow">Print archive</div>
    <h3>{d.publication||'Original publication'}</h3>
    <div class="publication-details">
      {d.magazineIssue&&<p><span>Issue</span><strong>{d.magazineIssue}</strong></p>}
      {d.printedPages&&<p><span>Page</span><strong>{d.printedPages}</strong></p>}
    </div>
    {d.cover&&<img src={d.cover} alt={(d.publication||'Publication')+' cover'} loading="lazy" />}
  </aside>}
</article>
{(newer||older)&&<nav class="wrap article-nav" aria-label="More writing">
  <div>{newer&&<a href={'/writing/'+newer.data.slug}><span>Newer</span><strong>{newer.data.title}</strong></a>}</div>
  <div>{older&&<a href={'/writing/'+older.data.slug}><span>Older</span><strong>{older.data.title}</strong></a>}</div>
</nav>}
</BaseLayout>
