---
import BaseLayout from '../layouts/BaseLayout.astro';
import { currentNovel } from '../data/current';
const genreLabel=currentNovel.genre.replace(/-/g,' ');
---
<BaseLayout title="Fiction — Alex Franquelli" description="Fiction by Alex Franquelli, including an untitled science-fiction novel in progress.">
  <section class="fiction-page wrap">
    <header class="fiction-header">
      <div class="fiction-header-meta">
        <div class="eyebrow">Fiction · Work in progress</div>
        <span class="fiction-status">{currentNovel.badge}</span>
      </div>
      <h1>{currentNovel.title}</h1>
      <p class="fiction-premise">{currentNovel.premise}</p>
    </header>

    <section class="fiction-manuscript" aria-label="Novel in progress">
      <div class="fiction-facts">
        <div><span>Form</span><strong>Novel</strong></div>
        <div><span>Genre</span><strong class="genre-value">{genreLabel}</strong></div>
        <div><span>Status</span><strong>{currentNovel.status}</strong></div>
      </div>
      <blockquote>{currentNovel.quote}</blockquote>
      <span class="fiction-quote-label">From the manuscript</span>
    </section>

    <div class="fiction-contact">
      <p>The novel is still in progress. For fiction enquiries or representation, please get in touch.</p>
      <a class="text-link" href="/contact">Contact ↗</a>
    </div>
  </section>
</BaseLayout>
