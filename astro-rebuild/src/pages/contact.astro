---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Contact — Alex Franquelli" description="Contact Alex Franquelli.">
  <div class="simple contact-page">
    <div class="eyebrow">Contact</div>
    <h1>Get in touch.</h1>
    <p>For writing, work enquiries, archive corrections or anything else, use the form below.</p>

    <form class="contact-form" action="https://formspree.io/f/xppwjybp" method="POST">
      <div class="form-grid">
        <label>
          <span>Name</span>
          <input type="text" name="name" autocomplete="name" required />
        </label>
        <label>
          <span>Email</span>
          <input type="email" name="email" autocomplete="email" required />
        </label>
      </div>
      <label>
        <span>Subject</span>
        <input type="text" name="subject" autocomplete="off" />
      </label>
      <label>
        <span>Message</span>
        <textarea name="message" rows="8" required></textarea>
      </label>
      <div class="form-honeypot" aria-hidden="true">
        <label>Leave this field empty<input type="text" name="_gotcha" tabindex="-1" autocomplete="off" /></label>
      </div>
      <button class="button" type="submit">Send message</button>
    </form>

    <p class="contact-fallback">Prefer email? Write to <a class="text-link" href="mailto:alexfranquelli@proton.me">alexfranquelli@proton.me</a>.</p>
    <p>You can also find me on <a class="text-link" href="https://uk.linkedin.com/in/alexfranquelli" rel="me noopener">LinkedIn ↗</a>.</p>
  </div>
</BaseLayout>
