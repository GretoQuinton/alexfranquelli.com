---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Contact — Alex Franquelli" description="Contact Alex Franquelli.">
  <div class="simple contact-page">
    <div class="eyebrow">Contact</div>
    <h1>Get in touch.</h1>
    <p>For writing, work enquiries, archive corrections or anything else, use the form below.</p>

    <form class="contact-form" id="contact-form" action="https://formspree.io/f/xppwjybp" method="POST">
      <div class="form-grid">
        <label>
          <span>Name</span>
          <input type="text" name="name" autocomplete="name" required />
        </label>
        <label>
          <span>Email</span>
          <input type="email" name="email" autocomplete="email" required />
        </label>
      </div>
      <label>
        <span>Subject</span>
        <input type="text" name="subject" autocomplete="off" />
      </label>
      <label>
        <span>Message</span>
        <textarea name="message" rows="8" required></textarea>
      </label>
      <div class="form-honeypot" aria-hidden="true">
        <label>Leave this field empty<input type="text" name="_gotcha" tabindex="-1" autocomplete="off" /></label>
      </div>
      <div class="form-actions">
        <button class="button" type="submit">Send message</button>
        <p id="form-status" class="form-status" role="status" aria-live="polite"></p>
      </div>
      <p class="form-note">Sent via Formspree; nothing is stored on this site.</p>
    </form>

    <p class="contact-fallback">Prefer email? Write to <a class="text-link" href="mailto:alexfranquelli@proton.me">alexfranquelli@proton.me</a>.</p>
    <p>You can also find me on <a class="text-link" href="https://uk.linkedin.com/in/alexfranquelli" rel="me noopener">LinkedIn ↗</a>.</p>
  </div>

  <script is:inline>
    const form=document.querySelector('#contact-form');
    const status=document.querySelector('#form-status');
    const submit=form?.querySelector('button[type="submit"]');

    form?.addEventListener('submit',async event=>{
      if(!window.fetch||!window.FormData) return;
      event.preventDefault();
      if(submit?.disabled) return;

      const defaultLabel=submit?.textContent||'Send message';
      if(submit){
        submit.disabled=true;
        submit.textContent='Sending…';
      }
      if(status) status.textContent='Sending your message…';

      try{
        const response=await fetch(form.action,{
          method:'POST',
          body:new FormData(form),
          headers:{Accept:'application/json'}
        });
        if(!response.ok) throw new Error('Form submission failed');
        form.reset();
        if(status) status.textContent='Thanks — your message has been sent.';
      }catch{
        if(status) status.textContent='Sorry, something went wrong. Please try again or use the email address below.';
      }finally{
        if(submit){
          submit.disabled=false;
          submit.textContent=defaultLabel;
        }
      }
    });
  </script>
</BaseLayout>
