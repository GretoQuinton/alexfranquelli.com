---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Page not found — Alex Franquelli" description="The page you were looking for could not be found.">
  <section class="wrap error-page">
    <div class="eyebrow">404</div>
    <h1>Page not found.</h1>
    <p>The address may belong to an older version of the site, or the page may have moved.</p>
    <div class="actions">
      <a class="button" href="/writing">Browse the writing archive</a>
      <a class="text-link" href="/">Return home ↗</a>
    </div>
  </section>
</BaseLayout>
