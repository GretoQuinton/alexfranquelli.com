{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "alexfranquelli-com",
  "compatibility_date": "2026-09-24",
  "main": "src/worker.js",
  "preview_urls": true,
  "previews": {},
  "durable_objects": {
    "bindings": [
      { "name": "VISITOR_COUNTER", "class_name": "VisitorCounter" }
    ]
  },
  "exports": {
    "VisitorCounter": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/visits"],
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page"
  }
}
